<Application x:Class="RadioLog.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Card" Color="#111D31"/><SolidColorBrush x:Key="Accent" Color="#00C8FF"/><SolidColorBrush x:Key="Accent2" Color="#087EFF"/>
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#132A45"/><GradientStop Color="#071321" Offset="0.55"/><GradientStop Color="#0B2037" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#205A83"/><GradientStop Color="#102D4B" Offset="0.48"/><GradientStop Color="#081A2C" Offset="1"/></LinearGradientBrush>
    <Style x:Key="ControlPanel" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="#2379AA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="10"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#008ED6" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/></Setter.Value></Setter></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#EAF8FF"/><Setter Property="Margin" Value="6,6,6,12"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00BFFF" BlurRadius="7" ShadowDepth="0" Opacity="0.55"/></Setter.Value></Setter></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="{StaticResource ButtonBrush}"/><Setter Property="Foreground" Value="#F5FAFF"/><Setter Property="BorderBrush" Value="#2B83B8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="glow" Background="Transparent" BorderBrush="#3500C8FF" BorderThickness="3" CornerRadius="9" Margin="-2"/><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><Border Height="1" VerticalAlignment="Top" Background="#88BDEBFF"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14618F"/><Setter TargetName="b" Property="BorderBrush" Value="#35D9FF"/><Setter TargetName="glow" Property="BorderBrush" Value="#6600C8FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#071323"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="#00C8FF"/><Setter Property="BorderBrush" Value="#294C6C"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#071323"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="#00C8FF"/><Setter Property="BorderBrush" Value="#294C6C"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="4"/><Setter Property="MaxDropDownHeight" Value="180"/><Setter Property="IsEditable" Value="False"/><Setter Property="Background" Value="#EAF6FF"/><Setter Property="Foreground" Value="#081426"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="7,5"/><Setter Property="Foreground" Value="#DCEEFF"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="row" Background="{TemplateBinding Background}" BorderBrush="#2A5370" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="14" Height="14" CornerRadius="2" Background="#F7FBFF" BorderBrush="#8ECDEB" BorderThickness="1"><Path x:Name="tick" Data="M 2 7 L 6 11 L 13 2" Stroke="#071323" StrokeThickness="2.2" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tick" Property="Visibility" Value="Visible"/><Setter TargetName="row" Property="BorderBrush" Value="#9FD7EC"/><Setter TargetName="row" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="row" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9FC2DC"/><Setter Property="Background" Value="#0B1729"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="#21425F" BorderThickness="1,1,1,0" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tabBorder" Property="Background" Value="#12618D"/><Setter TargetName="tabBorder" Property="BorderBrush" Value="#00C8FF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tabBorder" Property="Background" Value="#173C5D"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Menu"><Setter Property="Background" Value="#071727"/><Setter Property="Foreground" Value="White"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#F1F8FC"/><Setter Property="Background" Value="#0A1F32"/><Setter Property="Padding" Value="10,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Grid><Border x:Name="MenuBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/><TextBlock x:Name="Arrow" Grid.Column="1" Text="›" Foreground="#56DFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid></Border><Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" PopupAnimation="Fade"><Border Background="#071727" BorderBrush="#2389BB" BorderThickness="1" CornerRadius="5" Padding="4"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.65"/></Border.Effect><ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/><Setter Property="Padding" Value="9,4"/></Trigger><Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBorder" Property="Background" Value="#12618D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="MenuBorder" Property="Background" Value="#0D5077"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#668296"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGrid"><Setter Property="BorderBrush" Value="#1D4969"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowBackground" Value="#0B1728"/><Setter Property="AlternatingRowBackground" Value="#101F34"/><Setter Property="HorizontalGridLinesBrush" Value="#1A3049"/><Setter Property="VerticalGridLinesBrush" Value="#1A3049"/></Style>
  </Application.Resources>
</Application>
