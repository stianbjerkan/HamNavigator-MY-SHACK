<UserControl x:Class="RadioLog.Ft8AdvancedPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#07111F" Foreground="White">
 <UserControl.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="27"/><Setter Property="FontSize" Value="11"/></Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="2"/><Setter Property="Height" Value="27"/><Setter Property="FontSize" Value="11"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="11"/></Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Padding" Value="4,2"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="10"/></Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/></Style></UserControl.Resources>
 <Grid Margin="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="145"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="Auto"/><RowDefinition Height="245"/></Grid.RowDefinitions>
  <Border Background="#091827" BorderBrush="#1D5475" BorderThickness="0,0,0,1" Padding="4,2"><TextBlock x:Name="CpuText" Text="CPU  •  KLAR" Foreground="#62DFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/></Border>
  <Grid Grid.Row="1" Background="#DCE8F0"><Canvas x:Name="ScaleCanvas" SizeChanged="ScaleChanged"/></Grid>
  <Border x:Name="WaterfallHost" Grid.Row="2" Background="Black" BorderBrush="#258BC2" BorderThickness="1" Cursor="SizeWE" MouseLeftButtonDown="WaterfallMouseDown" MouseRightButtonDown="WaterfallMouseDown" MouseMove="WaterfallMouseMove" MouseLeftButtonUp="WaterfallMouseUp" MouseRightButtonUp="WaterfallMouseUp" MouseWheel="WaterfallMouseWheel"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="15"/></Grid.RowDefinitions>
   <Grid x:Name="WaterfallDisplays"><Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="SecondDisplayRow" Height="0"/></Grid.RowDefinitions><Border BorderBrush="#1C75A2" BorderThickness="0,0,0,1"><Grid><Image x:Name="Waterfall" Stretch="Fill"/><Canvas x:Name="Overlay" IsHitTestVisible="False"/><TextBlock x:Name="RxMarker" Text="RX: 1500 Hz   TX: 1500 Hz" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Foreground="#4DEBFF" FontWeight="Bold"/></Grid></Border><Image x:Name="Waterfall2" Grid.Row="1" Stretch="Fill" Visibility="Collapsed"/></Grid>
   <Grid Grid.Column="1" Background="#02070C"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button x:Name="DisplayModeButton" Content="1D" Padding="0" Margin="1" MinHeight="20" FontWeight="Bold" Foreground="#F5C451" ToolTip="Bytt mellom ett og to waterfall" Click="ToggleDisplayMode"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="13"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="T&#x0a;U&#x0a;N&#x0a;E" Foreground="White" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/><Slider x:Name="WaterfallTune" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="100" Value="50" ToolTip="Display tune 0–100" ValueChanged="WaterfallVisualChanged"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="13"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="D&#x0a;I&#x0a;S&#x0a;P" Foreground="White" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/><Slider x:Name="WaterfallContrast" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="24" Value="12" ToolTip="Display contrast 0–24" ValueChanged="WaterfallVisualChanged"/></Grid></Grid>
   <Border Grid.Row="1" Grid.ColumnSpan="2"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#071323"/><GradientStop Color="#004BFF" Offset=".2"/><GradientStop Color="#00E5FF" Offset=".4"/><GradientStop Color="#27E854" Offset=".58"/><GradientStop Color="#FFE600" Offset=".75"/><GradientStop Color="#FF2500" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  </Grid></Border>
  <Grid Grid.Row="3" Margin="0,4"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="32"/></Grid.RowDefinitions><UniformGrid Grid.Row="0" Columns="2"><Button Content="LAGRE DISPLAY 1" Click="SaveDisplayClick"/><Button Content="LAGRE DISPLAY 2" Click="SaveDisplayClick"/></UniformGrid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="90"/><ColumnDefinition Width="105"/><ColumnDefinition Width="45"/><ColumnDefinition Width="45"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox SelectedIndex="0"><ComboBoxItem>Hastighet 9</ComboBoxItem><ComboBoxItem>Hastighet 6</ComboBoxItem><ComboBoxItem>Hastighet 3</ComboBoxItem></ComboBox><ComboBox x:Name="StartHz" Grid.Column="1" SelectedIndex="0"><ComboBoxItem>Start 100 Hz</ComboBoxItem><ComboBoxItem>Start 200 Hz</ComboBoxItem><ComboBoxItem>Start 300 Hz</ComboBoxItem></ComboBox><ComboBox x:Name="Bandwidth" Grid.Column="2" SelectedIndex="1"><ComboBoxItem>BW 2800 Hz</ComboBoxItem><ComboBoxItem>BW 3200 Hz</ComboBoxItem><ComboBoxItem>BW 4000 Hz</ComboBoxItem></ComboBox><CheckBox Grid.Column="3" Content="FD" ToolTip="Flatten Display"/><CheckBox Grid.Column="4" Content="AF" ToolTip="Auto Flatten Display" IsChecked="True"/><Button Grid.Column="5" Content="DECODE" Click="DecodeClick"/><Button Grid.Column="6" Content="RECEIVE" Click="MonitorClick"/><StackPanel Grid.Column="7" Orientation="Horizontal"><CheckBox x:Name="AutoDecode" Content="Auto Dec" IsChecked="True"/><CheckBox Content="RT Dec"/><TextBlock x:Name="Txing" Text="TXing: AV" Foreground="#F5C451" VerticalAlignment="Center" Margin="12,0"/></StackPanel></Grid></Grid>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DataGrid x:Name="AllMessages" IsReadOnly="True" AutoGenerateColumns="False" Background="#091827" Foreground="White" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" CanUserAddRows="False" HeadersVisibility="Column">
    <DataGrid.Columns><DataGridTextColumn Header="Tid" Binding="{Binding SlotUtc, StringFormat=HH:mm:ss}" Width="70"/><DataGridTextColumn Header="dB" Binding="{Binding Snr}" Width="48"/><DataGridTextColumn Header="DT" Binding="{Binding Dt, StringFormat=F1}" Width="48"/><DataGridTextColumn Header="Melding 0" Binding="{Binding Text}" Width="*"/><DataGridTextColumn Header="Freq" Binding="{Binding AudioHz, StringFormat=F0}" Width="62"/></DataGrid.Columns>
   </DataGrid>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#278BC0"/>
   <DataGrid x:Name="RxMessages" Grid.Column="2" IsReadOnly="True" AutoGenerateColumns="False" Background="#091827" Foreground="White" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" CanUserAddRows="False" HeadersVisibility="Column">
    <DataGrid.Columns><DataGridTextColumn Header="Tid" Binding="{Binding SlotUtc, StringFormat=HH:mm:ss}" Width="70"/><DataGridTextColumn Header="dB" Binding="{Binding Snr}" Width="48"/><DataGridTextColumn Header="DT" Binding="{Binding Dt, StringFormat=F1}" Width="48"/><DataGridTextColumn Header="RX Frekvens Melding" Binding="{Binding Text}" Width="*"/><DataGridTextColumn Header="Freq" Binding="{Binding AudioHz, StringFormat=F0}" Width="62"/></DataGrid.Columns>
   </DataGrid>
  </Grid>
  <UniformGrid Grid.Row="5" Columns="7" Margin="0,4"><Button Content="MONITOR" Click="MonitorClick"/><Button Content="STOPP MONITOR" Click="StopMonitorClick"/><Button Content="TØM MELDINGER" Click="ClearClick"/><Button Content="TØM RX-FREKVENS" Click="ClearRxClick"/><Button Content="AVSLUTT QSO" Click="HaltClick"/><Button Content="STOPP TX" Background="#812C45" Click="StopTxClick"/><Button Content="TUNE" Background="#8A5B16" Click="TuneClick"/></UniformGrid>
  <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="44*"/><ColumnDefinition Width="30*"/><ColumnDefinition Width="26*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource ControlPanel}" Margin="0,0,5,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="CALL GRID     USB  14.074.000" Foreground="#62DFFF" FontWeight="Bold" FontSize="15"/><WrapPanel Grid.Row="1"><Button Content="LEGG TIL LOGGEN"/><TextBlock Text="TIL RADIO:" Foreground="#FF6C6C" VerticalAlignment="Center"/><TextBox x:Name="DxCall" Width="120"/><TextBlock Text="RX RPT" VerticalAlignment="Center"/><TextBox x:Name="Report" Text="-10" Width="55"/></WrapPanel><WrapPanel Grid.Row="2"><TextBlock Text="LOKATOR:" Foreground="#FF6C6C" VerticalAlignment="Center"/><TextBox x:Name="DxGrid" Width="95"/><TextBlock Text="DB:NA" VerticalAlignment="Center"/><Button Content="SØK"/><Button Content="LEGG TIL"/></WrapPanel><WrapPanel Grid.Row="3"><TextBlock Text="Mitt kall" VerticalAlignment="Center"/><TextBox x:Name="StationCall" Width="95"/><TextBlock Text="Locator" VerticalAlignment="Center"/><TextBox x:Name="StationGrid" Width="90"/><TextBlock Text="RX Hz" VerticalAlignment="Center"/><TextBox x:Name="RxHz" Text="1500" Width="55" TextChanged="FrequencyTextChanged"/><TextBlock Text="TX Hz" VerticalAlignment="Center"/><TextBox x:Name="TxHz" Text="1500" Width="55" TextChanged="FrequencyTextChanged"/></WrapPanel><WrapPanel Grid.Row="4"><TextBlock x:Name="UtcClock" FontSize="17" FontWeight="Bold" Foreground="#EAF8FF"/><TextBlock Text="   DT" VerticalAlignment="Center"/><Slider Width="85" Minimum="-2" Maximum="2" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True"/></WrapPanel></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource ControlPanel}" Margin="0,0,5,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="66"/></Grid.RowDefinitions><WrapPanel Margin="0,1"><CheckBox Content="Super Hound"/><CheckBox Content="Super Fox"/></WrapPanel><WrapPanel Grid.Row="1" Margin="0,1"><TextBlock Text="DF Tol" VerticalAlignment="Center"/><Slider Width="120" Minimum="100" Maximum="2500" Value="1500"/><TextBlock Text="± 800 Hz" VerticalAlignment="Center"/></WrapPanel><WrapPanel Grid.Row="2" Margin="0,1"><CheckBox Content="LTR" IsChecked="True"/><Button Content="TX = RX"/><TextBlock Text="TX RPT" VerticalAlignment="Center"/><TextBox Text="-10" Width="50"/></WrapPanel><WrapPanel Grid.Row="3" Margin="0,1"><ComboBox Width="105" SelectedIndex="0"><ComboBoxItem>ASeq TX/RX 15 s</ComboBoxItem><ComboBoxItem>ASeq RX/TX 15 s</ComboBoxItem></ComboBox><TextBlock Text="QRG" VerticalAlignment="Center"/><TextBox Text="345" Width="55"/><CheckBox x:Name="TxFirst" Content="TX FØRSTE"/><CheckBox x:Name="TxOther" Content="TX ANDRE"/></WrapPanel><Grid Grid.Row="4" Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Row="0" Grid.Column="0" Content="GEN MLD" Click="GenerateClick"/><Button Grid.Row="0" Grid.Column="1" x:Name="AutoButton" Content="AUTO ER AV" Click="AutoClick"/><CheckBox Grid.Row="1" Grid.Column="0" x:Name="AutoNext" Content="AUTO NESTE QSO" VerticalAlignment="Center"/><CheckBox Grid.Row="1" Grid.Column="1" x:Name="Arm" Content="ARMER TX" VerticalAlignment="Center"/></Grid></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource ControlPanel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Grid.Column="0" Text="RX" Foreground="#62DFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="TX" Foreground="#FF6C6C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Grid Grid.Row="1" Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition/><RowDefinition Height="15"/></Grid.RowDefinitions><TextBlock Text="+20" Foreground="#FF9A9A" FontSize="9" HorizontalAlignment="Center"/><Slider x:Name="RxLevel" Grid.Row="1" Orientation="Vertical" Minimum="-20" Maximum="20" Value="0" ToolTip="RX-nivå +20 til -20 dB"/><TextBlock Grid.Row="2" Text="-20" Foreground="#8EBBFF" FontSize="9" HorizontalAlignment="Center"/></Grid>
    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="31"/></Grid.RowDefinitions>
     <TabControl x:Name="QueueTabs" Background="#071323" BorderBrush="#276D95">
      <TabItem x:Name="QueueTab" Header="Kø 0" Padding="7,4"><DataGrid x:Name="TxList" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="#071323" Foreground="White" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Call" Binding="{Binding Call}" Width="*"/><DataGridTextColumn Header="Avst" Binding="{Binding Distance}" Width="50"/><DataGridTextColumn Header="Freq" Binding="{Binding Frequency}" Width="52"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem x:Name="NowTab" Header="Nå 0" Padding="7,4"><DataGrid x:Name="NowList" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="#071323" Foreground="White" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Call" Binding="{Binding Call}" Width="*"/><DataGridTextColumn Header="Avst" Binding="{Binding Distance}" Width="50"/><DataGridTextColumn Header="Freq" Binding="{Binding Frequency}" Width="52"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="Innstillinger" Padding="7,4"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="5">
       <TextBlock Text="MULTI ANSWER" Foreground="#62DFFF" FontWeight="Bold" Margin="2,1,2,4"/>
       <WrapPanel><TextBlock Text="Køgrense" Width="92" VerticalAlignment="Center"/><TextBox Text="5" Width="48" ToolTip="MSHV Queue Limit: 0–50"/></WrapPanel>
       <WrapPanel><TextBlock Text="TX-spor" Width="92" VerticalAlignment="Center"/><TextBox Text="1" Width="48" ToolTip="Antall samtidige TX-spor"/></WrapPanel>
       <WrapPanel><TextBlock Text="CQ-type" Width="92" VerticalAlignment="Center"/><ComboBox Width="92" SelectedIndex="0"><ComboBoxItem>Standard</ComboBoxItem><ComboBoxItem>POTA</ComboBoxItem><ComboBoxItem>SOTA</ComboBoxItem><ComboBoxItem>BOTA</ComboBoxItem></ComboBox></WrapPanel>
       <WrapPanel><TextBlock Text="Maks QSO/kall" Width="92" VerticalAlignment="Center"/><ComboBox Width="92" SelectedIndex="0"><ComboBoxItem>Ingen grense</ComboBoxItem><ComboBoxItem>1 QSO</ComboBoxItem><ComboBoxItem>2 QSOs</ComboBoxItem><ComboBoxItem>3 QSOs</ComboBoxItem></ComboBox></WrapPanel>
       <WrapPanel><TextBlock Text="Autosortering" Width="92" VerticalAlignment="Center"/><ComboBox Width="92" SelectedIndex="0"><ComboBoxItem>Sortering av</ComboBoxItem><ComboBoxItem>Distanse</ComboBoxItem><ComboBoxItem>S/N (dB)</ComboBoxItem></ComboBox></WrapPanel>
       <CheckBox Content="Send CQ på ledig spor"/><CheckBox Content="Spør ved duplikat-QSO"/>
      </StackPanel></ScrollViewer></TabItem>
     </TabControl>
     <Button Grid.Row="1" Content="SEND VALGT" Click="SendSelectedClick"/>
    </Grid>
    <Grid Grid.Row="1" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition/><RowDefinition Height="15"/></Grid.RowDefinitions><TextBlock Text="MAX" Foreground="#FF9A9A" FontSize="9" HorizontalAlignment="Center"/><Slider x:Name="TxLevel" Grid.Row="1" Orientation="Vertical" Minimum="0" Maximum="100" Value="75" ToolTip="TX-nivå minimum til maksimum"/><TextBlock Grid.Row="2" Text="MIN" Foreground="#8EBBFF" FontSize="9" HorizontalAlignment="Center"/></Grid>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
